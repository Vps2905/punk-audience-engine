AUDIENCE_API_KEY=
REQUIRE_AUDIENCE_API_KEY=true
PRODUCTION_MODE=true
# Loopback-only operator workspace. Never enable in production.
AUDIENCE_LOCAL_UI_ENABLED=false
AUDIENCE_LOCAL_UI_TENANT_ID=punk_internal
SYNTHETIC_ENGINE=dp_aggregate
ALLOW_SYNTHETIC_FALLBACK=false
K_ANONYMITY_MIN=1000
ECHO_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Audience Intelligence v2
EMBEDDING_SCOPE=all_safe_cohorts
EMBEDDING_BACKEND=sklearn_hashing
EMBEDDING_MAX_FEATURES=384
DATA_FRESHNESS_STALE_HOURS=48

# Phase 2 - versioned feature registry and true pgvector retrieval
# Existing July data can be indexed only as historical_preview. Historical
# feature sets remain permanently blocked from activation/export.
PHASE2_FEATURES_ENABLED=false
AUDIENCE_FEATURE_DATABASE_URL=
AUDIENCE_FEATURE_WRITER_DATABASE_URL=
AUDIENCE_FEATURE_MIGRATION_DATABASE_URL=
AUDIENCE_PROPOSAL_DATABASE_URL=
PHASE2_FEATURE_READER_USER=punk_feature_reader
PHASE2_FEATURE_READER_PASSWORD=
PHASE2_FEATURE_WRITER_USER=punk_feature_writer
PHASE2_FEATURE_WRITER_PASSWORD=
PHASE2_PROPOSAL_RUNTIME_USER=punk_proposal_runtime
PHASE2_PROPOSAL_RUNTIME_PASSWORD=
PGVECTOR_DIMENSION=384
PHASE2_RETRIEVAL_BACKEND=pgvector
PGVECTOR_HNSW_EF_SEARCH=100
REQUIRE_PUNK_AI_TENANT_SIGNATURE=true
PUNK_AI_TENANT_AUTH_SECRET=

# Module 2 production feature builds. This path accepts only privacy-safe
# canonical cohort rows, uses an approved immutable model revision and writes
# non-activatable versioned features to pgvector. It never falls back to the
# legacy hashing backend.
PRODUCTION_FEATURE_BUILDS_ENABLED=false
FEATURE_EMBEDDING_BACKEND=sentence_transformers
FEATURE_EMBEDDING_MODEL_NAME=
FEATURE_EMBEDDING_MODEL_REVISION=
LOCAL_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_SEMANTIC_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Prefetch writes a revision-addressed artifact and checksum manifest here.
LOCAL_SEMANTIC_MODEL_CACHE=
FEATURE_EMBEDDING_DIMENSION=384
FEATURE_EMBEDDING_BATCH_SIZE=256
FEATURE_EMBEDDING_DEVICE=cpu
FEATURE_EMBEDDING_EXTERNAL_ENDPOINT=
FEATURE_EMBEDDING_EXTERNAL_AUTH_SECRET_ARN=

# Manual-start local Phase 2 pgvector target. Keep the password in the local
# untracked .env or deployment secret manager; never commit its value.
PHASE2_PGVECTOR_DATABASE=punk_audience_features
PHASE2_PGVECTOR_USER=punk_feature_admin
PHASE2_PGVECTOR_PASSWORD=
PHASE2_PGVECTOR_PORT=55432

# Production provider object gateway
# PostgreSQL remains the operational/serving store. S3 is the immutable
# provider landing and canonical replay layer.
PROVIDER_GATEWAY_ENABLED=false
PROVIDER_INGESTION_DATABASE_URL=
# Operator-only admin URL. Do not inject this into API or worker runtimes.
PROVIDER_INGESTION_MIGRATION_DATABASE_URL=
# Local manual-start Punk-owned provider control database. These values are
# never used for the historical Echo source.
MODULE1_CONTROL_DATABASE=punk_provider_control
MODULE1_CONTROL_ADMIN_USER=punk_provider_admin
MODULE1_CONTROL_PASSWORD=
MODULE1_CONTROL_PORT=55433
MODULE1_PROVIDER_RUNTIME_USER=punk_provider_runtime
MODULE1_PROVIDER_RUNTIME_PASSWORD=
PROVIDER_S3_REGION=
PROVIDER_S3_ROLE_ARN=
PROVIDER_S3_EXTERNAL_ID=
PROVIDER_SQS_QUEUE_URL=
PROVIDER_SQS_DLQ_URL=
PROVIDER_WORKER_MAX_MESSAGES=5
PROVIDER_WORKER_WAIT_TIME_SECONDS=20
PROVIDER_WORKER_VISIBILITY_TIMEOUT_SECONDS=300
PROVIDER_WORKER_MAX_RECEIVE_COUNT=5
PROVIDER_WORKER_RETRY_BASE_SECONDS=30
PROVIDER_WORKER_RETRY_MAX_SECONDS=900
PROVIDER_WORKER_STALE_PROCESSING_SECONDS=900
# Objects above each registered contract's bounded in-process thresholds are
# never loaded into the API worker. When enabled, they are dispatched by
# immutable object fingerprint to a Standard Step Functions workflow that
# runs the distributed privacy/canonicalization data plane.
PROVIDER_DISTRIBUTED_PROCESSING_ENABLED=false
PROVIDER_DISTRIBUTED_STATE_MACHINE_ARN=
PROVIDER_DISTRIBUTED_EXECUTION_PREFIX=punk-provider
# Distributed jobs copy the exact provider object version into this
# Punk-owned, short-retention raw staging prefix, validate the full SHA-256,
# and delete it after terminal processing. Values ending in _ARN are secret
# references only; secret values never enter job arguments.
PROVIDER_DISTRIBUTED_CONTROL_PLANE_LAMBDA_ARN=
PROVIDER_DISTRIBUTED_GLUE_JOB_NAME=
PROVIDER_DISTRIBUTED_STAGING_BUCKET=
PROVIDER_DISTRIBUTED_STAGING_PREFIX=provider-distributed-staging
PROVIDER_DISTRIBUTED_STAGING_ENCRYPTION=aws:kms
PROVIDER_DISTRIBUTED_STAGING_KMS_KEY_ID=
PROVIDER_INGESTION_DATABASE_SECRET_ARN=
PROVIDER_DISTRIBUTED_TOKENIZATION_SECRET_ARN=
PROVIDER_DISTRIBUTED_DP_SEED_SECRET_ARN=
PROVIDER_DISTRIBUTED_RECONCILIATION_STALE_SECONDS=900
CANONICAL_S3_BUCKET=
CANONICAL_S3_PREFIX=canonical
CANONICAL_S3_ROLE_ARN=
CANONICAL_S3_EXTERNAL_ID=
CANONICAL_S3_SERVER_SIDE_ENCRYPTION=AES256
CANONICAL_S3_KMS_KEY_ID=
AUDIENCE_DP_SEED_SECRET=
# HMAC-SHA256 key for bounded/local provider tokenization. In production,
# inject this from the deployment secret manager; never reuse a public salt.
AUDIENCE_TOKENIZATION_HMAC_KEY=

# Module 5 - Autonomous LLM model router
ENABLE_LLM_INTENT=true
LLM_INTENT_PROVIDER=gemini
LLM_INTENT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Plain entries use LLM_INTENT_PROVIDER.
# Cross-provider entry format: provider::model
LLM_INTENT_MODEL_CHAIN=
LLM_INTENT_TIMEOUT_SECONDS=20
LLM_INTENT_MAX_CONTEXT_ITEMS=12
LLM_INTENT_MAX_TOKENS=300
LLM_INTENT_MIN_CONFIDENCE=0.65
LLM_ROUTER_MAX_MODELS=5
LLM_ROUTER_MAX_ATTEMPTS_PER_MODEL=2
LLM_ROUTER_RETRY_BACKOFF_SECONDS=0.5

# Module 5.2 - Autonomous supervisor foundation
# Keep disabled until API integration and graph routing acceptance tests pass.
ENABLE_AUTONOMOUS_SUPERVISOR=false
AUTONOMOUS_SUPERVISOR_FAIL_CLOSED=true

# Module 5.2 Stage 5 - controlled LangGraph execution
# Requires ENABLE_AUTONOMOUS_SUPERVISOR=true as the parent gate.
ENABLE_AUTONOMOUS_SUPERVISOR_GRAPH=false

# Module 5.2 Stage 6A - bounded graph recovery
AUTONOMOUS_SUPERVISOR_MAX_ORCHESTRATOR_ATTEMPTS=2
AUTONOMOUS_SUPERVISOR_RETRY_BACKOFF_SECONDS=0.25

# Module 5.1-5.5 - governed agent execution control plane.
# Evidence generation is opt-in. Release-affecting capabilities remain disabled.
MODULE5_EXECUTION_EVIDENCE_PATH=
MODULE5_POLICY_EVIDENCE_PATH=
MODULE5_CIRCUIT_BREAKER_EVIDENCE_PATH=
MODULE5_HUMAN_REVIEW_EVIDENCE_PATH=
MODULE5_RECOVERY_EVIDENCE_PATH=
MODULE5_GOVERNED_EXECUTION_ENABLED=false
MODULE5_POLICY_EVALUATION_ENABLED=false
MODULE5_CIRCUIT_BREAKER_ENABLED=false
MODULE5_SHADOW_REVIEW_ENABLED=false
MODULE5_AUTONOMOUS_MUTATION_ENABLED=false
MODULE5_PRODUCTION_ROUTING_ENABLED=false

# Module 5.6 - bounded autonomous planning, criticism and replan shadow kernel.
# Objective/tool payloads are never persisted and production effects stay disabled.
MODULE5_BOUNDED_AUTONOMY_EVIDENCE_PATH=
MODULE5_BOUNDED_AUTONOMY_SHADOW_ENABLED=false
MODULE5_BOUNDED_AUTONOMY_MAX_TASKS=16
MODULE5_BOUNDED_AUTONOMY_MAX_TOTAL_ATTEMPTS=24
MODULE5_BOUNDED_AUTONOMY_MAX_REPLANS=1
MODULE5_BOUNDED_AUTONOMY_MAX_PARALLEL_TASKS=4

# Module 5.7 - real-service adapters and legacy/autonomous dual-run comparison.
# Comparison is observational only and cannot alter the authoritative route.
MODULE5_BOUNDED_AUTONOMY_COMPARISON_EVIDENCE_PATH=
MODULE5_BOUNDED_AUTONOMY_DUAL_RUN_ENABLED=false
MODULE5_BOUNDED_AUTONOMY_MAX_SOURCE_ROW_DELTA=0
MODULE5_BOUNDED_AUTONOMY_MAX_VECTOR_COUNT_DELTA=0
MODULE5_BOUNDED_AUTONOMY_MAX_RANKED_MATCH_DELTA=0
MODULE5_BOUNDED_AUTONOMY_MAX_SELECTED_COHORT_DELTA=0
MODULE5_BOUNDED_AUTONOMY_MAX_PREPARED_CANDIDATE_DELTA=0

# Module 5.8 - repeated unseen-goal shadow certification.
# Certification evidence is observational and never authorizes live cutover.
MODULE5_BOUNDED_AUTONOMY_CERTIFICATION_EVIDENCE_PATH=
MODULE5_BOUNDED_AUTONOMY_CERTIFICATION_ENABLED=false
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_RUNS=25
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_UNIQUE_GOALS=10
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_TERMINAL_SAFETY_RUNS=5
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_REVIEW_RUNS=5
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_ROUTE_AGREEMENT=1.0
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_STAGE_AGREEMENT=1.0
MODULE5_BOUNDED_AUTONOMY_CERT_MIN_FRESHNESS_AGREEMENT=1.0
MODULE5_BOUNDED_AUTONOMY_CERT_MAX_DIVERGENCE_RATE=0.0
MODULE5_BOUNDED_AUTONOMY_CERT_MAX_CRITICAL_DIVERGENCE_RATE=0.0
MODULE5_BOUNDED_AUTONOMY_CERT_MAX_P95_LATENCY_MS=250.0
MODULE5_BOUNDED_AUTONOMY_CERT_MAX_CASES=10000

# Module 5.9 - real read-only functional shadow execution across Modules 1-5.

# This remains disabled until Module 5.8 certification evidence is linked and
# the staging operator has configured a privacy-safe feature snapshot reader.

MODULE5_BOUNDED_AUTONOMY_FUNCTIONAL_SHADOW_EVIDENCE_PATH=
MODULE5_BOUNDED_AUTONOMY_FUNCTIONAL_SHADOW_ENABLED=false
MODULE5_FUNCTIONAL_SHADOW_MAX_SAFE_FEATURE_ROWS=5000
MODULE5_FUNCTIONAL_SHADOW_MAX_VECTOR_COUNT_DELTA=0
MODULE5_FUNCTIONAL_SHADOW_MAX_RANKED_MATCH_DELTA=0
MODULE5_FUNCTIONAL_SHADOW_MAX_SELECTED_COHORT_DELTA=0
MODULE5_FUNCTIONAL_SHADOW_MAX_TOTAL_LATENCY_MS=15000
MODULE5_FUNCTIONAL_SHADOW_MAX_STAGE_LATENCY_MS=10000
MODULE5_FUNCTIONAL_SHADOW_MAX_PEAK_PYTHON_BYTES=1073741824

# Module 5.10 - per-capability authorization and adversarial certification.
# Agent identities are short lived. Agents cannot approve, deliver or perform
# production effects. Live authority remains disabled pending external IdP,
# penetration, fresh-data and activation-sandbox certification.
MODULE5_AGENT_SECURITY_CERTIFICATION_EVIDENCE_PATH=
MODULE5_AGENT_SECURITY_CERTIFICATION_ENABLED=false
MODULE5_AGENT_CAPABILITY_AUTHORIZATION_REQUIRED=true
MODULE5_AGENT_PRODUCTION_EFFECT_AUTHORIZATION_ENABLED=false

# Module 5.11 - measured scale, latency and recovery certification.
# The default gate requires at least 10k real safe work units and four-way
# observed concurrency. Passing evidence is staging-review-only and never
# enables a live cutover.
MODULE5_SCALE_RECOVERY_CERTIFICATION_EVIDENCE_PATH=
MODULE5_SCALE_RECOVERY_CERTIFICATION_ENABLED=false
MODULE5_SCALE_RECOVERY_PRODUCTION_CUTOVER_ENABLED=false
MODULE5_SCALE_RECOVERY_MIN_TOTAL_WORK_UNITS=10000
MODULE5_SCALE_RECOVERY_MIN_INVOCATIONS=16
MODULE5_SCALE_RECOVERY_MIN_OBSERVED_CONCURRENCY=4
MODULE5_SCALE_RECOVERY_MIN_WORK_UNITS_PER_SECOND=50
MODULE5_SCALE_RECOVERY_MIN_VECTOR_QUERIES_PER_SECOND=0
MODULE5_SCALE_RECOVERY_MAX_P95_LATENCY_MS=2000
MODULE5_SCALE_RECOVERY_MAX_P99_LATENCY_MS=5000
MODULE5_SCALE_RECOVERY_MAX_DATABASE_WAIT_P99_MS=500
MODULE5_SCALE_RECOVERY_MAX_QUEUE_DEPTH=10000
MODULE5_SCALE_RECOVERY_MAX_PEAK_PYTHON_BYTES=1073741824
MODULE5_SCALE_RECOVERY_REQUIRE_OBSERVED_WORK_UNITS=true
MODULE5_SCALE_RECOVERY_REQUIRE_HISTORICAL_PIPELINE=true

# Cross-module aggregate ML/data-quality monitoring.
# Monitoring evidence is opt-in; alerts remain review-only and undispatched.
QUALITY_MONITORING_EVIDENCE_PATH=
QUALITY_DRIFT_EVIDENCE_PATH=
QUALITY_ALERT_PLAN_EVIDENCE_PATH=
QUALITY_MONITORING_ENABLED=false
QUALITY_ALERTING_ENABLED=false
QUALITY_AUTOMATIC_REMEDIATION_ENABLED=false
QUALITY_PRODUCTION_ROUTING_ENABLED=false

# Cross-module production observability and SLO governance.
# Evidence generation is opt-in. Incident actions remain review-only.
OBSERVABILITY_SNAPSHOT_EVIDENCE_PATH=
OBSERVABILITY_INCIDENT_PLAN_EVIDENCE_PATH=
OBSERVABILITY_MONITORING_ENABLED=false
OBSERVABILITY_ALERTING_ENABLED=false
OBSERVABILITY_AUTOMATIC_REMEDIATION_ENABLED=false
OBSERVABILITY_PRODUCTION_ROUTING_ENABLED=false

# Production application and deployment security hardening.
# Evidence is non-secret and release authorization remains disabled.
SECURITY_POSTURE_EVIDENCE_PATH=
SECURITY_REVIEW_EVIDENCE_PATH=
SECURITY_HARDENING_ENABLED=false
SECURITY_PRODUCTION_RELEASE_ENABLED=false
SECURITY_HEADERS_ENABLED=true
EXPOSE_API_DOCS=false
PRODUCTION_ALLOWED_HOSTS=
PRODUCTION_CORS_ORIGINS=
MAX_REQUEST_BODY_BYTES=10485760
REQUIRE_DATABASE_TLS=true
REQUIRE_OUTBOUND_TLS=true
SECRETS_INJECTED_BY_SECRET_MANAGER=false
CONTAINER_RUNTIME_NON_ROOT=true
CONTAINER_ROOT_FILESYSTEM_READ_ONLY=true
CONTAINER_NO_NEW_PRIVILEGES=true
DEBUG=false

# Production Infrastructure as Code governance.
# Validation is opt-in; apply and traffic gates remain disabled.
INFRASTRUCTURE_ASSESSMENT_EVIDENCE_PATH=
INFRASTRUCTURE_REVIEW_EVIDENCE_PATH=
PREPRODUCTION_DEPLOYMENT_CERTIFICATION_PATH=
INFRASTRUCTURE_VALIDATION_ENABLED=false
INFRASTRUCTURE_APPLY_ENABLED=false
INFRASTRUCTURE_PRODUCTION_TRAFFIC_ENABLED=false

# Local semantic temporal override margin.
# When temporal evidence is ambiguous, the winning daypart
# must beat competitors and abstention by at least this margin.
LOCAL_SEMANTIC_TEMPORAL_OVERRIDE_MARGIN=0.05

# Audience Quality Policy
AUDIENCE_HIGH_QUALITY_ABSOLUTE_FLOOR=0.60
AUDIENCE_HIGH_QUALITY_PERCENTILE=0.70
AUDIENCE_HIGH_QUALITY_MAX_GAP_FROM_BEST=0.15
AUDIENCE_HIGH_QUALITY_MIN_CANDIDATES=1
AUDIENCE_QUALITY_SEMANTIC_MIN_CONFIDENCE=0.20
AUDIENCE_QUALITY_SEMANTIC_MARGIN=0.02

# Module 2 full completion: certification, index lifecycle, and shadow serving.
# All release-affecting flags remain disabled until explicit operator approval.
MODULE2_CERTIFICATION_REPORT_PATH=
MODULE2_SHADOW_REPORT_PATH=
MODULE2_INDEX_RECORD_PATH=
MODULE2_INDEX_LIFECYCLE_DATABASE_URL=
MODULE2_SHADOW_SERVING_ENABLED=false
MODULE2_MODEL_REGISTRATION_ENABLED=false
MODULE2_PRODUCTION_ROUTING_ENABLED=false

# Module 3.1-3.6 - governed cohort and Punk AI shadow evidence.
# Lifecycle and shadow evaluation write observation evidence only. Mutation,
# routing, activation, and export remain disabled until explicit approval.
MODULE3_COHORT_EVIDENCE_PATH=
MODULE3_OVERLAP_EVIDENCE_PATH=
MODULE3_LOOKALIKE_EVIDENCE_PATH=
MODULE3_LIFECYCLE_EVIDENCE_PATH=
MODULE3_SHADOW_EVIDENCE_PATH=
MODULE3_COHORT_GENERATION_ENABLED=false
MODULE3_COHORT_PERSISTENCE_ENABLED=false
MODULE3_OVERLAP_DEDUPLICATION_ENABLED=false
MODULE3_LOOKALIKE_GENERATION_ENABLED=false
MODULE3_LIFECYCLE_EVALUATION_ENABLED=false
MODULE3_LIFECYCLE_MUTATION_ENABLED=false
MODULE3_SHADOW_OBSERVATION_ENABLED=false
MODULE3_PRODUCTION_ROUTING_ENABLED=false

# Module 4.1 - immutable aggregate evolution snapshot evidence.
MODULE4_EVOLUTION_SNAPSHOT_EVIDENCE_PATH=
MODULE4_DRIFT_EVIDENCE_PATH=
MODULE4_RECOMMENDATION_EVIDENCE_PATH=
MODULE4_APPROVAL_SHADOW_EVIDENCE_PATH=
MODULE4_RECOVERY_EVIDENCE_PATH=
MODULE4_EVOLUTION_SNAPSHOT_ENABLED=false
MODULE4_DRIFT_DETECTION_ENABLED=false
MODULE4_RECOMMENDATION_ENABLED=false
MODULE4_SHADOW_VALIDATION_ENABLED=false
MODULE4_AUTOMATIC_EVOLUTION_ENABLED=false
MODULE4_PRODUCTION_ROUTING_ENABLED=false

# Production fresh-data Module 1 -> Module 2 -> Module 3 workflow
FRESH_DATA_WORKFLOW_ENABLED=false
FRESH_DATA_WORKFLOW_AUTOMATIC_TRIGGER_ENABLED=false
FRESH_DATA_WORKFLOW_WORKER_LEASE_SECONDS=300
FRESH_DATA_WORKFLOW_MAX_ATTEMPTS=5

# Production fresh-data trigger worker. Disabled until deployment review.
FRESH_DATA_WORKFLOW_TRIGGER_POLL_SECONDS=30
FRESH_DATA_WORKFLOW_TRIGGER_BATCH_LIMIT=50
FRESH_DATA_WORKFLOW_DATA_USE_MODE=offline_evaluation
FRESH_DATA_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FRESH_DATA_EMBEDDING_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
